# Neon Postgres: Vercel/Neon injects this after connecting the integration.
DATABASE_URL=

# Better Auth. Generate a random secret with at least 32 characters.
BETTER_AUTH_SECRET=
# Local: http://localhost:3000. Production: your Vercel domain.
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob store token for ad and profile images.
BLOB_READ_WRITE_TOKEN=

# Optional: email address authorized to moderate reports and verifications.
ADMIN_EMAIL=
